<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Daltons AI — All-in-One Marketing Platform</title>
  <meta name="description" content="Daltons AI is hét all-in-one marketingplatform. Vervang al je losse tools door één systeem. CRM, funnels, e-mail, social media en AI-automatisering.">
  <meta name="keywords" content="all-in-one marketing platform, CRM, funnel builder, e-mail automatisering, social media, Daltons AI">
  <meta property="og:title" content="Daltons AI — All-in-One Marketing Platform">
  <meta property="og:description" content="Vervang al je losse tools door één compleet systeem.">
  <meta property="og:type" content="website">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">

  <style>
    /* =====================================================
       CUSTOM PROPERTIES — DALTONS AI BRAND
    ===================================================== */
    :root {
      --black:   #0A0A0A;
      --carbon:  #1A1A1A;
      --gold:    #F5B301;
      --cyan:    #00E5FF;
      --white:   #E8E8E8;
      --slate:   #2C3E50;
      --font-head: 'Space Grotesk', sans-serif;
      --font-body: 'Inter', sans-serif;
      --ease:    cubic-bezier(0.25, 0.46, 0.45, 0.94);
      --radius:  14px;
    }

    /* =====================================================
       RESET
    ===================================================== */
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--black);
      color: var(--white);
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.6;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }
    img, svg { display: block; max-width: 100%; }
    a { text-decoration: none; }

    /* =====================================================
       TYPOGRAPHY
    ===================================================== */
    h1, h2, h3, h4 { font-family: var(--font-head); font-weight: 700; color: var(--white); line-height: 1.15; }
    .label {
      font-family: var(--font-head);
      font-weight: 600;
      font-size: 11px;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--gold);
      display: inline-block;
      margin-bottom: 16px;
    }
    .glow-line {
      width: 56px; height: 2px;
      background: var(--gold);
      margin: 16px 0 40px;
      box-shadow: 0 0 14px rgba(245,179,1,0.6);
    }

    /* =====================================================
       PRELOADER
    ===================================================== */
    #preloader {
      position: fixed; inset: 0;
      background: var(--black);
      z-index: 9999;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      transition: opacity 0.7s var(--ease), visibility 0.7s var(--ease);
    }
    #preloader.hidden { opacity: 0; visibility: hidden; }
    .pl-logo { opacity: 0; animation: plFade 0.9s ease 0.3s forwards; }
    .pl-text {
      font-family: var(--font-head); font-weight: 700;
      font-size: 30px; letter-spacing: 0.12em;
      color: var(--white); margin-top: 22px;
      opacity: 0; animation: plUp 0.7s ease 1.0s forwards;
    }
    @keyframes plFade { from{opacity:0;transform:scale(0.65)} to{opacity:1;transform:scale(1)} }
    @keyframes plUp   { from{opacity:0;transform:translateY(18px)} to{opacity:1;transform:translateY(0)} }

    /* =====================================================
       NAVIGATION
    ===================================================== */
    #navbar {
      position: fixed; top: 0; left: 0; right: 0; z-index: 900;
      padding: 22px 64px;
      display: flex; align-items: center; justify-content: space-between;
      transition: background 0.4s, border-color 0.4s, backdrop-filter 0.4s;
      border-bottom: 1px solid transparent;
    }
    #navbar.scrolled {
      background: rgba(10,10,10,0.92);
      backdrop-filter: blur(16px);
      border-color: rgba(245,179,1,0.12);
    }
    .nav-logo { display: flex; align-items: center; gap: 12px; }
    .nav-logo-text {
      font-family: var(--font-head); font-size: 20px; font-weight: 700;
      color: var(--white); letter-spacing: 0.04em;
    }
    .nav-links { display: flex; align-items: center; gap: 36px; list-style: none; }
    .nav-links a {
      font-family: var(--font-head); font-size: 14px; font-weight: 500;
      color: rgba(232,232,232,0.65); transition: color 0.25s;
    }
    .nav-links a:hover { color: var(--gold); }
    .nav-cta {
      background: var(--gold) !important;
      color: var(--black) !important;
      padding: 10px 22px; border-radius: 7px;
      font-weight: 600 !important;
      transition: transform 0.2s, box-shadow 0.2s !important;
    }
    .nav-cta:hover { transform: translateY(-1px); box-shadow: 0 6px 22px rgba(245,179,1,0.38) !important; }
    .nav-burger { display: none; cursor: pointer; flex-direction: column; gap: 5px; background: none; border: none; padding: 4px; }
    .nav-burger span { width: 24px; height: 2px; background: var(--white); border-radius: 2px; transition: 0.3s; display: block; }

    /* Mobile nav overlay */
    #mobile-menu {
      display: none; position: fixed; inset: 0;
      background: rgba(10,10,10,0.97);
      z-index: 950;
      flex-direction: column; align-items: center; justify-content: center; gap: 40px;
    }
    #mobile-menu.open { display: flex; }
    #mobile-menu a {
      font-family: var(--font-head); font-size: 30px; font-weight: 700;
      color: var(--white); transition: color 0.2s;
    }
    #mobile-menu a:hover { color: var(--gold); }
    #mob-close {
      position: absolute; top: 24px; right: 24px;
      background: none; border: none; cursor: pointer;
    }

    /* =====================================================
       BUTTONS
    ===================================================== */
    .btn {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 16px 34px; border-radius: 9px;
      font-family: var(--font-head); font-size: 16px; font-weight: 500;
      cursor: pointer; border: none; transition: transform 0.2s, box-shadow 0.2s;
      white-space: nowrap;
    }
    .btn-gold {
      background: var(--gold); color: var(--black);
      box-shadow: 0 4px 22px rgba(245,179,1,0.32);
    }
    .btn-gold:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(245,179,1,0.55); }
    .btn-outline {
      background: transparent; color: var(--white);
      border: 1.5px solid rgba(245,179,1,0.55);
    }
    .btn-outline:hover { border-color: var(--gold); color: var(--gold); transform: translateY(-2px); }
    .btn-pulse {
      animation: goldPulse 2.6s ease-in-out infinite;
    }
    @keyframes goldPulse {
      0%,100% { box-shadow: 0 4px 22px rgba(245,179,1,0.32); }
      50%      { box-shadow: 0 4px 44px rgba(245,179,1,0.72), 0 0 70px rgba(245,179,1,0.18); }
    }

    /* =====================================================
       SECTIONS
    ===================================================== */
    section { position: relative; overflow: hidden; padding: 120px 64px; }
    .bg-dark   { background: var(--black); }
    .bg-carbon { background: var(--carbon); }
    .container { max-width: 1220px; margin: 0 auto; position: relative; z-index: 3; }
    .section-head { margin-bottom: 64px; }
    .section-head h2 { font-size: clamp(36px, 4vw, 58px); margin-bottom: 20px; }
    .section-head p  { font-size: 18px; color: rgba(232,232,232,0.68); max-width: 580px; line-height: 1.72; }
    .grid-pattern {
      position: absolute; inset: 0;
      background-image: radial-gradient(rgba(0,229,255,0.035) 1px, transparent 1px);
      background-size: 42px 42px;
      pointer-events: none; z-index: 0;
    }

    /* =====================================================
       DALTON SILHOUETTES (background)
    ===================================================== */
    .dalton-bg {
      position: absolute; bottom: 0; z-index: 1;
      opacity: 0.065; pointer-events: none; will-change: transform;
      filter: blur(0.5px);
    }
    .dalton-bg.right  { right: -50px; }
    .dalton-bg.left   { left:  -50px; }
    .dalton-bg.center { left: 50%; transform: translateX(-50%); }

    /* =====================================================
       HERO
    ===================================================== */
    #hero {
      min-height: 100vh; display: flex; align-items: center;
      padding: 160px 64px 100px; background: var(--black);
    }
    #hero-canvas { position: absolute; inset: 0; z-index: 0; }
    .hero-content { position: relative; z-index: 3; max-width: 720px; }
    .hero-h1 {
      font-size: clamp(46px, 6.5vw, 84px);
      line-height: 1.08; margin-bottom: 26px;
    }
    .hero-h1 .gold { color: var(--gold); }
    .hero-sub {
      font-size: 19px; line-height: 1.72;
      color: rgba(232,232,232,0.72);
      margin-bottom: 44px; max-width: 560px;
    }
    .hero-btns { display: flex; gap: 16px; flex-wrap: wrap; }

    /* =====================================================
       CARDS (shared)
    ===================================================== */
    .card {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: var(--radius);
      padding: 32px;
      transition: border-color 0.3s, box-shadow 0.3s, transform 0.3s;
    }
    .card:hover {
      border-color: var(--gold);
      box-shadow: 0 8px 44px rgba(245,179,1,0.1), 0 0 0 1px rgba(0,229,255,0.06);
      transform: translateY(-4px);
    }
    .card-icon {
      width: 50px; height: 50px;
      background: rgba(245,179,1,0.09);
      border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 24px; margin-bottom: 20px;
    }
    .card h3 { font-size: 20px; margin-bottom: 10px; }
    .card p  { font-size: 15px; color: rgba(232,232,232,0.62); }

    /* =====================================================
       SECTION 2 — PROBLEM
    ===================================================== */
    .problem-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; }

    /* =====================================================
       SECTION 3 — FEATURES
    ===================================================== */
    .feature-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 20px; }

    /* =====================================================
       SECTION 4 — WHY
    ===================================================== */
    .why-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 24px; }
    .why-card { padding: 48px 40px; }
    .why-card .why-label {
      font-size: 11px; font-weight: 600; letter-spacing: 0.2em;
      text-transform: uppercase; margin-bottom: 16px;
      font-family: var(--font-head);
    }
    .why-card h3  { font-size: 28px; margin-bottom: 14px; }
    .why-card p   { font-size: 15px; color: rgba(232,232,232,0.62); }
    .gold-text  { color: var(--gold); }
    .cyan-text  { color: var(--cyan); }

    /* =====================================================
       SECTION 5 — STATS
    ===================================================== */
    .stats-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 32px; text-align: center; }
    .stat-num {
      font-family: var(--font-head);
      font-size: clamp(58px, 7vw, 90px);
      font-weight: 700; color: var(--gold);
      line-height: 1; margin-bottom: 12px; display: block;
    }
    .stat-label { font-size: 16px; color: rgba(232,232,232,0.68); }
    @keyframes cyanGlow {
      0%   { text-shadow: 0 0 32px var(--cyan), 0 0 64px var(--cyan); }
      100% { text-shadow: none; }
    }
    .stat-num.glow { animation: cyanGlow 0.6s ease forwards; }

    /* =====================================================
       SECTION 6 — HOW IT WORKS
    ===================================================== */
    .steps-grid  { display: grid; grid-template-columns: repeat(3,1fr); gap: 32px; }
    .step-card   { text-align: center; }
    .step-num {
      width: 66px; height: 66px; border-radius: 50%;
      border: 2px solid var(--gold); color: var(--gold);
      font-family: var(--font-head); font-size: 24px; font-weight: 700;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 24px;
      transition: background 0.3s, color 0.3s;
    }
    .step-card:hover .step-num { background: var(--gold); color: var(--black); }
    .step-card h3 { font-size: 22px; margin-bottom: 12px; }
    .step-card p  { font-size: 15px; color: rgba(232,232,232,0.62); }

    /* =====================================================
       SECTION 7 — PRICING
    ===================================================== */
    .pricing-wrap { display: grid; grid-template-columns: repeat(2,1fr); gap: 32px; max-width: 880px; margin: 0 auto; }
    .pricing-card { padding: 48px 40px; }
    .pricing-card.featured {
      border-color: var(--gold);
      box-shadow: 0 0 70px rgba(245,179,1,0.14), 0 0 130px rgba(245,179,1,0.05);
    }
    .pricing-badge {
      display: inline-block; background: var(--gold); color: var(--black);
      font-family: var(--font-head); font-size: 11px; font-weight: 700;
      letter-spacing: 0.15em; text-transform: uppercase;
      padding: 5px 13px; border-radius: 5px; margin-bottom: 26px;
    }
    .pricing-plan  { font-size: 12px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold); margin-bottom: 8px; font-family: var(--font-head); font-weight: 600; }
    .pricing-price { font-family: var(--font-head); font-size: 54px; font-weight: 700; color: var(--white); line-height: 1; margin-bottom: 4px; }
    .pricing-price sup { font-size: 24px; vertical-align: top; padding-top: 10px; }
    .pricing-period { font-size: 13px; color: rgba(232,232,232,0.45); margin-bottom: 34px; }
    .pricing-features { list-style: none; margin-bottom: 36px; display: flex; flex-direction: column; gap: 13px; }
    .pricing-features li { display: flex; align-items: flex-start; gap: 10px; font-size: 15px; color: rgba(232,232,232,0.78); }
    .pricing-features li::before { content: '✓'; color: var(--gold); font-weight: 700; flex-shrink: 0; margin-top: 1px; }
    .pricing-card .btn { width: 100%; justify-content: center; }

    /* =====================================================
       SECTION 8 — FAQ
    ===================================================== */
    .faq-list { display: flex; flex-direction: column; gap: 12px; max-width: 820px; }
    .faq-item { border: 1px solid rgba(255,255,255,0.09); border-radius: 13px; overflow: hidden; transition: border-color 0.3s; }
    .faq-item.open { border-color: var(--gold); }
    .faq-q {
      display: flex; align-items: center; justify-content: space-between;
      padding: 24px 28px; cursor: pointer; gap: 16px;
      font-family: var(--font-head); font-size: 17px; font-weight: 600; color: var(--white);
      user-select: none;
      transition: color 0.25s;
    }
    .faq-q:hover { color: var(--gold); }
    .faq-icon {
      flex-shrink: 0; width: 26px; height: 26px; border-radius: 50%;
      border: 1.5px solid rgba(245,179,1,0.5);
      display: flex; align-items: center; justify-content: center;
      transition: transform 0.35s, background 0.3s, border-color 0.3s;
    }
    .faq-item.open .faq-icon { background: var(--gold); border-color: var(--gold); transform: rotate(45deg); }
    .faq-icon-svg { width: 13px; height: 13px; }
    .faq-a {
      max-height: 0; overflow: hidden;
      transition: max-height 0.42s var(--ease), padding 0.42s;
    }
    .faq-a-inner {
      padding: 0 28px 26px;
      font-size: 15px; line-height: 1.72;
      color: rgba(232,232,232,0.68);
    }
    .faq-item.open .faq-a { max-height: 320px; }

    /* =====================================================
       SECTION 9 — CTA
    ===================================================== */
    #cta { text-align: center; padding: 160px 64px; }
    #cta h2 { font-size: clamp(40px, 5.5vw, 70px); margin-bottom: 24px; max-width: 680px; margin-left: auto; margin-right: auto; }
    #cta .cta-sub { font-size: 18px; color: rgba(232,232,232,0.68); margin-bottom: 52px; max-width: 500px; margin-left: auto; margin-right: auto; }
    .cta-btns { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
    .gold-particles { position: absolute; inset: 0; pointer-events: none; z-index: 1; }

    /* =====================================================
       FOOTER
    ===================================================== */
    footer { background: #050505; border-top: 1px solid rgba(245,179,1,0.1); padding: 60px 64px; }
    .footer-top { max-width: 1220px; margin: 0 auto; display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 40px; padding-bottom: 40px; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .footer-brand { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; }
    .footer-brand-name { font-family: var(--font-head); font-size: 19px; font-weight: 700; color: var(--white); }
    .footer-contact { font-size: 14px; color: rgba(232,232,232,0.5); line-height: 2; }
    .footer-contact a { color: rgba(232,232,232,0.6); transition: color 0.2s; }
    .footer-contact a:hover { color: var(--gold); }
    .footer-socials { display: flex; gap: 12px; }
    .footer-socials a {
      width: 42px; height: 42px; border-radius: 9px;
      border: 1px solid rgba(255,255,255,0.1);
      display: flex; align-items: center; justify-content: center;
      color: rgba(232,232,232,0.55); font-size: 16px;
      transition: border-color 0.25s, color 0.25s, background 0.25s;
    }
    .footer-socials a:hover { border-color: var(--gold); color: var(--gold); background: rgba(245,179,1,0.07); }
    .footer-bottom { max-width: 1220px; margin: 32px auto 0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
    .footer-copy, .footer-powered { font-size: 13px; color: rgba(232,232,232,0.38); }

    /* =====================================================
       FADE-UP ANIMATIONS
    ===================================================== */
    .fu {
      opacity: 0; transform: translateY(38px);
      transition: opacity 0.72s var(--ease), transform 0.72s var(--ease);
    }
    .fu.vis { opacity: 1; transform: translateY(0); }
    .d1 { transition-delay: 0.08s; }
    .d2 { transition-delay: 0.18s; }
    .d3 { transition-delay: 0.28s; }
    .d4 { transition-delay: 0.38s; }
    .d5 { transition-delay: 0.48s; }
    .d6 { transition-delay: 0.58s; }
    .d7 { transition-delay: 0.68s; }
    .d8 { transition-delay: 0.78s; }

    /* =====================================================
       RESPONSIVE
    ===================================================== */
    @media (max-width: 1100px) {
      section { padding: 90px 44px; }
      #navbar { padding: 20px 44px; }
      #hero  { padding: 150px 44px 90px; }
      .feature-grid { grid-template-columns: repeat(2,1fr); }
      .stats-grid   { grid-template-columns: repeat(2,1fr); gap: 44px; }
    }
    @media (max-width: 768px) {
      section { padding: 80px 24px; }
      #navbar { padding: 16px 24px; }
      #hero   { padding: 130px 24px 80px; }
      footer  { padding: 50px 24px; }
      .nav-links  { display: none; }
      .nav-burger { display: flex; }
      .feature-grid  { grid-template-columns: 1fr; }
      .problem-grid  { grid-template-columns: 1fr; }
      .why-grid      { grid-template-columns: 1fr; }
      .steps-grid    { grid-template-columns: 1fr; }
      .pricing-wrap  { grid-template-columns: 1fr; }
      .hero-btns     { flex-direction: column; align-items: flex-start; }
      .cta-btns      { flex-direction: column; align-items: center; }
      .dalton-bg     { display: none; } /* performance on mobile */
      .footer-top    { flex-direction: column; }
      .footer-bottom { flex-direction: column; text-align: center; }
    }
    @media (max-width: 480px) {
      .stats-grid    { grid-template-columns: 1fr; }
      .hero-h1       { font-size: 36px; }
      #cta h2        { font-size: 36px; }
      .pricing-wrap  { max-width: 100%; }
    }
  </style>
</head>

<body>

<!-- =====================================================
     PRELOADER
===================================================== -->
<div id="preloader">
  <div class="pl-logo">
    <svg width="90" height="90" viewBox="0 0 90 90" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="90" height="90" rx="18" fill="#0A0A0A" stroke="#F5B301" stroke-width="1.5"/>
      <!-- D -->
      <path d="M12 24 h12 q16 0 16 21 q0 21-16 21 H12 Z M21 34 v22 h3 q8 0 8-11 q0-11-8-11 Z" fill="#F5B301"/>
      <!-- A -->
      <path d="M45 65 l12-41 h4 l12 41 h-9 l-2-8 H56 l-2 8 Z M57.5 50 l-3-12 -3 12 Z" fill="#F5B301"/>
      <!-- Crosshair in A (viersprong) -->
      <line x1="58.5" y1="43" x2="58.5" y2="55" stroke="#0A0A0A" stroke-width="2" stroke-linecap="round"/>
      <line x1="52.5" y1="49" x2="64.5" y2="49" stroke="#0A0A0A" stroke-width="2" stroke-linecap="round"/>
      <!-- I -->
      <rect x="76" y="24" width="8" height="41" rx="2" fill="#F5B301"/>
    </svg>
  </div>
  <div class="pl-text">Daltons AI</div>
</div>

<!-- =====================================================
     MOBILE MENU
===================================================== -->
<div id="mobile-menu">
  <button id="mob-close">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
      <path d="M18 6L6 18M6 6l12 12" stroke="#E8E8E8" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </button>
  <a href="#probleem" onclick="closeMob()">Het Probleem</a>
  <a href="#oplossing" onclick="closeMob()">Oplossing</a>
  <a href="#resultaten" onclick="closeMob()">Resultaten</a>
  <a href="#pricing" onclick="closeMob()">Pricing</a>
  <a href="#faq" onclick="closeMob()">FAQ</a>
  <a href="#cta" class="btn btn-gold" style="font-size:20px" onclick="closeMob()">Plan een Demo →</a>
</div>

<!-- =====================================================
     NAVIGATION
===================================================== -->
<nav id="navbar">
  <a href="#" class="nav-logo">
    <svg width="38" height="38" viewBox="0 0 38 38" fill="none">
      <rect width="38" height="38" rx="7" fill="#F5B301"/>
      <text x="5" y="27" font-family="Space Grotesk,sans-serif" font-size="17" font-weight="700" fill="#0A0A0A">DAI</text>
    </svg>
    <span class="nav-logo-text">Daltons AI</span>
  </a>
  <ul class="nav-links">
    <li><a href="#probleem">Het Probleem</a></li>
    <li><a href="#oplossing">Oplossing</a></li>
