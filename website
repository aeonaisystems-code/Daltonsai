<!-- =====================================================
     SCRIPTS — GSAP + ScrollTrigger
===================================================== -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

<script>
/* =============================================
   1. PRELOADER
============================================= */
document.body.style.overflow = 'hidden';
window.addEventListener('load', () => {
  setTimeout(() => {
    document.getElementById('preloader').classList.add('hidden');
    document.body.style.overflow = '';
  }, 2000);
});

/* =============================================
   2. NAVBAR SCROLL EFFECT
============================================= */
const navbar = document.getElementById('navbar');
window.addEventListener('scroll', () => {
  navbar.classList.toggle('scrolled', window.scrollY > 60);
}, { passive: true });

/* =============================================
   3. MOBILE MENU
============================================= */
document.getElementById('burger').addEventListener('click', () =>
  document.getElementById('mobile-menu').classList.add('open'));
document.getElementById('mob-close').addEventListener('click', closeMob);
function closeMob() {
  document.getElementById('mobile-menu').classList.remove('open');
}

/* =============================================
   4. HERO PARTICLE CANVAS
============================================= */
(function initParticles() {
  const canvas = document.getElementById('hero-canvas');
  const ctx    = canvas.getContext('2d');
  const CYAN   = '0,229,255';
  const GOLD   = '245,179,1';
  let   W, H, particles = [];

  function resize() {
    W = canvas.width  = canvas.offsetWidth;
    H = canvas.height = canvas.offsetHeight;
  }
  resize();
  window.addEventListener('resize', resize, { passive: true });

  function rand(min, max) { return Math.random() * (max - min) + min; }

  function spawn() {
    const isGold = Math.random() < 0.08;
    return {
      x:      rand(0, W),
      y:      rand(0, H),
      r:      rand(0.6, 2.2),
      vx:     rand(0.4, 1.6),
      vy:     rand(-0.3, 0.3),
      alpha:  rand(0.1, 0.55),
      color:  isGold ? GOLD : CYAN,
    };
  }

  for (let i = 0; i < 90; i++) particles.push(spawn());

  function draw() {
    ctx.clearRect(0, 0, W, H);
    particles.forEach(p => {
      p.x += p.vx;
      p.y += p.vy;
      if (p.x > W + 4) { Object.assign(p, spawn()); p.x = -2; }
      ctx.globalAlpha = p.alpha;
      ctx.fillStyle   = `rgba(${p.color},1)`;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fill();
    });
    ctx.globalAlpha = 1;
    requestAnimationFrame(draw);
  }
  draw();
})();

/* =============================================
   5. FADE-UP (IntersectionObserver)
============================================= */
const fuObserver = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      e.target.classList.add('vis');
      fuObserver.unobserve(e.target);
    }
  });
}, { threshold: 0.12 });
document.querySelectorAll('.fu').forEach(el => fuObserver.observe(el));

/* =============================================
   6. COUNT-UP ANIMATION
============================================= */
const countObserver = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (!e.isIntersecting) return;
    const el     = e.target;
    const target = parseInt(el.dataset.target);
    const suffix = el.dataset.suffix || '';
    const dur    = 2000;
    const t0     = performance.now();
    function tick(now) {
      const prog  = Math.min((now - t0) / dur, 1);
      const eased = 1 - Math.pow(1 - prog, 3); // ease-out cubic
      el.textContent = Math.round(eased * target) + suffix;
      if (prog < 1) { requestAnimationFrame(tick); }
      else {
        el.textContent = target + suffix;
        el.classList.add('glow');
        setTimeout(() => el.classList.remove('glow'), 700);
      }
    }
    requestAnimationFrame(tick);
    countObserver.unobserve(el);
  });
}, { threshold: 0.5 });
document.querySelectorAll('.stat-num[data-target]').forEach(el => countObserver.observe(el));

/* =============================================
   7. FAQ ACCORDION
============================================= */
document.querySelectorAll('.faq-q').forEach(q => {
  q.addEventListener('click', () => {
    const item   = q.parentElement;
    const isOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item.open').forEach(i => i.classList.remove('open'));
    if (!isOpen) item.classList.add('open');
  });
});

/* =============================================
   8. GSAP PARALLAX — Desktop only
============================================= */
if (window.matchMedia('(min-width: 769px)').matches) {
  gsap.registerPlugin(ScrollTrigger);

  const daltons = [
    { id: 'd-joe',     trigger: '#hero' },
    { id: 'd-william', trigger: '#probleem' },
    { id: 'd-jack',    trigger: '#oplossing' },
    { id: 'd-averell', trigger: '#waarom' },
  ];

  daltons.forEach(({ id, trigger }) => {
    const el = document.getElementById(id);
    if (!el) return;
    gsap.to(el, {
      yPercent: 18,
      ease: 'none',
      scrollTrigger: {
        trigger,
        start: 'top bottom',
        end:   'bottom top',
        scrub: 2.2,
      },
    });
  });

  /* Staggered card reveals */
  document.querySelectorAll('.feature-grid .card, .why-grid .card').forEach((card, i) => {
    ScrollTrigger.create({
      trigger: card,
      start:   'top 92%',
      once:    true,
      onEnter: () => gsap.fromTo(card,
        { opacity: 0, y: 28 },
        { opacity: 1, y: 0, duration: 0.6, delay: (i % 4) * 0.11, ease: 'power2.out' }
      ),
    });
  });
}

/* =============================================
   9. GOLD FLOATING PARTICLES (CTA section)
============================================= */
(function spawnGoldParticles() {
  const container = document.getElementById('gp');
  if (!container) return;
  for (let i = 0; i < 22; i++) {
    const d = document.createElement('div');
    const s = Math.random() * 4 + 2;
    const x = Math.random() * 100;
    const y = Math.random() * 100;
    const dur = Math.random() * 8 + 6;
    const delay = Math.random() * 5;
    d.style.cssText = `
      position:absolute;
      width:${s}px; height:${s}px;
      background:#F5B301;
      border-radius:50%;
      opacity:${Math.random() * 0.35 + 0.08};
      top:${y}%; left:${x}%;
      animation:gpFloat ${dur}s ease-in-out ${delay}s infinite alternate;
      box-shadow:0 0 ${s * 2}px rgba(245,179,1,0.6);
    `;
    container.appendChild(d);
  }
  const style = document.createElement('style');
  style.textContent = '@keyframes gpFloat{from{transform:translate(0,0)}to{transform:translate(18px,-36px)}}';
  document.head.appendChild(style);
})();
</script>

</body>
</html>
